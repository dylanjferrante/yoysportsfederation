# The SQLite database lives at data/nexus.db (created by `npx tsx src/db/migrate.ts`).
# There is no DATABASE_URL to configure for local development.

NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Tank01 (RapidAPI) sports data — optional ─────────────────────────────────
# Add these to your private .env (already git-ignored), NOT here.
# Without a key, the app falls back to built-in mock/seed data automatically.
# Get your key from RapidAPI after subscribing to the Tank01 APIs.
TANK01_RAPIDAPI_KEY=""
# Per-sport RapidAPI hosts (copy from each API's "Code Snippets" tab on RapidAPI):
TANK01_HOST_NFL=""
TANK01_HOST_NBA=""
TANK01_HOST_NHL=""
TANK01_HOST_MLB=""
