{
  "name": "nexus-fantasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "tsx src/db/migrate.ts && tsx src/db/seed.ts && tsx scripts/backfill-playoffs.ts && tsx scripts/backfill-daily-stats.ts",
    "setup": "npm install && npm run db:reset",
    "stats:pull": "tsx scripts/stats-pull.ts",
    "stats:project": "tsx scripts/derive-projections.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "tank01:probe": "tsx scripts/tank01-probe.ts",
    "tank01:pull": "tsx scripts/tank01-pull.ts",
    "tank01:schedule": "tsx scripts/tank01-schedule.ts",
    "tank01:sync": "tsx scripts/tank01-sync.ts",
    "tank01:realstats": "tsx scripts/tank01-realstats.ts",
    "ysf:import": "tsx scripts/ysf-import.ts",
    "tank01:refresh": "tsx scripts/tank01-realstats.ts --days=3 && npm run db:reset",
    "ysf:sync": "tsx scripts/ysf-sync.ts",
    "ysf:score": "tsx scripts/ysf-score.ts",
    "fantrax:capture": "tsx scripts/fantrax-capture.ts",
    "nhl:sync": "tsx scripts/nhl-sync.ts",
    "ysf:injuries": "tsx scripts/ysf-injuries.ts",
    "ysf:eligibility": "tsx scripts/ysf-eligibility.ts",
    "ysf:refresh": "tsx scripts/nhl-sync.ts && tsx scripts/ysf-sync.ts --stats && tsx scripts/ysf-injuries.ts && tsx scripts/fantrax-capture.ts && tsx scripts/ysf-score.ts --write"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "eslint-config-next": "^15.5.29",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.5",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "react": "^19",
    "react-dom": "^19",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "shell-quote": "1.12.0"
  }
}
